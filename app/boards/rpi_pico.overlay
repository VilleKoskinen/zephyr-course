/ {
    leds {
        addon_led0: addon_led_0 {
            gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
            label = "Addon LED0";
        };

        addon_led1: addon_led_1 {
            gpios = <&gpio0 21 GPIO_ACTIVE_HIGH>;
            label = "Addon LED1";
        };

        addon_led2: addon_led_2 {
            gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>;
            label = "Addon LED2";
        };
    };

    aliases {
        app-led = &addon_led0;
    };
};
